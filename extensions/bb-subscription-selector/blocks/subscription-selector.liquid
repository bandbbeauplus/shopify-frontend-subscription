{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign available_count = 0
  for variant in product.variants
    if variant.available
      assign available_count = available_count | plus: 1
    endif
  endfor
%}

<div
  class="bb-subscription"
  style="--bb-accent: {{ block.settings.accent_color }}; --bb-surface: {{ block.settings.surface_color }};"
  data-bb-subscription
  {{ block.shopify_attributes }}
>
  <div class="bb-subscription__heading">
    <span>{{ block.settings.eyebrow | escape }}</span>
    <h2>{{ block.settings.heading | escape }}</h2>
    {% if block.settings.description != blank %}
      <p>{{ block.settings.description | escape }}</p>
    {% endif %}
  </div>

  {% if product == blank %}
    <p class="bb-subscription__notice">Select a product to preview subscription plans.</p>
  {% elsif available_count == 0 %}
    <p class="bb-subscription__notice">These plans are currently sold out.</p>
  {% else %}
    <form class="bb-subscription__form" action="{{ routes.cart_add_url }}" method="post" data-bb-subscription-form>
      <div class="bb-subscription__plans" role="radiogroup" aria-label="Subscription plan">
        {% for variant in product.variants %}
          {% if variant.available %}
            {% assign months = variant.title | split: ' ' | first | plus: 0 %}
            {% if months < 1 %}{% assign months = 1 %}{% endif %}
            {% assign monthly_price = variant.price | divided_by: months %}
            {% assign is_selected = false %}
            {% if variant.id == selected_variant.id %}{% assign is_selected = true %}{% endif %}
            <label class="bb-subscription__plan{% if forloop.last and available_count > 2 %} bb-subscription__plan--featured{% endif %}">
              {% if forloop.last and available_count > 2 %}<span class="bb-subscription__popular">Best value</span>{% endif %}
              <input
                type="radio"
                name="id"
                value="{{ variant.id }}"
                {% if is_selected %}checked{% endif %}
              >
              <span class="bb-subscription__radio" aria-hidden="true"></span>
              <span class="bb-subscription__copy">
                <strong>{{ variant.title | escape }}</strong>
                <small>{{ monthly_price | money }} / delivery</small>
              </span>
              <span class="bb-subscription__price">{{ variant.price | money }}</span>
            </label>
          {% endif %}
        {% endfor %}
      </div>

      <input type="hidden" name="quantity" value="1">
      <button class="bb-subscription__submit" type="submit">
        <span>{{ block.settings.button_label | escape }}</span>
        <span aria-hidden="true">&#8594;</span>
      </button>
      <p class="bb-subscription__fineprint">{{ block.settings.fine_print | escape }}</p>
      <p class="bb-subscription__error" role="alert" hidden data-bb-subscription-error></p>
    </form>
  {% endif %}
</div>

{% schema %}
{
  "name": "Subscription plans",
  "target": "section",
  "stylesheet": "subscription-selector.css",
  "javascript": "subscription-selector.js",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CHOOSE YOUR ROUTINE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better days, delivered monthly." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Pay once, then receive your B&B BEAU+ supply every month." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe now" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Prepaid in full. No recurring charge." },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#214f40" },
    { "type": "color", "id": "surface_color", "label": "Surface", "default": "#f6f1e5" }
  ]
}
{% endschema %}
